# Copy this file to .env and fill in your values. Never commit .env.
# Full reference: docs/configuration.md. Only the variables below are
# read from the environment; anything else in .env is ignored.

# --- AI (Gemini, primary) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_actual_api_key_here

# --- AI fallbacks (used in order after Gemini; unset providers are skipped) ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- LLM mode + local endpoint (see docs/configuration.md "LLM Configuration") ---
# LLM_MODE: server (default) | off (no LLM calls, rule-based fallbacks) | byok
LLM_MODE=server
# Local OpenAI-compatible endpoint (e.g. Ollama). Unset = cloud providers only.
LLM_BASE_URL=
LLM_MODEL=llama3.2

# --- Flask ---
# REQUIRED in production: generate one, do not invent or reuse a placeholder:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Production boot refuses to start with an empty or known-placeholder key.
# (Dev only: an unset key falls back to an ephemeral key with a warning,
# and sessions reset on every restart.)
SECRET_KEY=

# --- Database ---
# Local dev default: SQLite file `acra.db` in the project root (created automatically).
# Production (Render / Postgres): paste the Internal Database URL, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# (postgres:// URLs are auto-converted to postgresql://)
# NOTE: which managed database production uses (Render free Postgres vs
# Neon) is tracked in docs/ops/neon-database-decision.md — confirm there
# before pointing a production deploy at a new database.
DATABASE_URL=sqlite:///acra.db

# --- Google Sign-In (OAuth 2.0) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, type "Web application"). Add BOTH redirect URIs:
#   http://localhost:5000/auth/google/callback
#   https://study-buddy-3m16.onrender.com/auth/google/callback
# If these are unset, Google sign-in is hidden automatically (email login still works).
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- GitHub API (optional) ---
# Raises the GitHub API rate limit 60 -> 5000 req/hour (used by the paper
# constructor + GitHub profile analyzer). Create at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# --- User API-key encryption (BYOK keys stored per user, Fernet-encrypted) ---
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEYS (comma-separated, NEWEST FIRST) enables rotation; FERNET_KEY is
# the single-key form. ENCRYPTION_KEY is the legacy fallback name.
FERNET_KEY=
# FERNET_KEYS=

# --- Error tracking (Sentry; disabled by default) ---
# No-op unless SENTRY_DSN is set AND sentry-sdk is installed (it is not
# in requirements.txt as of 2026-10-28 — see the audit-fixes progress
# note, BLOCKED B-3, for the enablement steps). Reports are PII-scrubbed
# by studybuddy/sentry_init.py before leaving the server.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Rate limits ---
# Default is in-process memory:// (exact on Render with its single
# worker; resets on deploy/restart). Set to a Redis URL for a shared
# store — see docs/ops/rate-limits.md. Never commit a real URL.
RATELIMIT_STORAGE_URI=

# --- Admins + misc ---
# Comma-separated admin emails (mentor verification, admin views).
STUDYBUDDY_ADMINS=
# Contact shown on research pages (optional).
RESEARCH_CONTACT_EMAIL=
# RAG embedder backend for the study library (optional).
RAG_EMBEDDER=
